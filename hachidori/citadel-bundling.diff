+test("Citadel group tabs filter sections in place and project each word's buttons onto the shown dictionaries", t => {
+  let selected;
+  const { popup, view, bound } = citadelFixture(t);
+  const context = { ...citadelContext, onDictionaryTabSelected(value) { selected = value; } };
+  view.renderResults([citadelResult, citadelSecond], { query: "食べた" }, context);
+  const tabs = [...popup.querySelectorAll(".citadel-tab")];
+  assert.deepEqual(tabs.map(tab => [tab.textContent, tab.getAttribute("aria-pressed")]),
+    [["All", "true"], ["Words", "false"], ["Japanese", "false"]]);
+  const [results, sections] = [[...popup.querySelectorAll(".citadel-result")], [...popup.querySelectorAll(".citadel-section")]];
+  tabs[2].click();
+  assert.deepEqual(selected, { groupId: "japanese" });
+  assert.deepEqual(sections.map(section => section.hidden), [true, false, false]);
+  assert.deepEqual(bound.current.miningActions.map(item => item.result.term.glossaries.map(row => row.dictionary)), [["国語"], ["国語"]],
+    "Anki receives only the shown dictionaries' definitions");
+  assert.equal(bound.current.audioButtons.length, 2);
+  tabs[1].click();
+  assert.deepEqual(results.map(result => result.hidden), [false, true], "a word without a section in the group hides");
+  assert.deepEqual(bound.current.miningActions.map(item => item.result.term.glossaries.length), [2]);
+  assert.equal(popup.querySelectorAll(".citadel-section")[0], sections[0], "switching tabs does not rebuild");
+  view.renderResults([citadelResult, citadelSecond], { query: "食べた" }, { ...context, ...view.captureTermView() });
+  assert.deepEqual([...popup.querySelectorAll(".citadel-section")].map(section => section.hidden), [false, true, true],
+    "Back restores the selected group");
+  // A word only frequency or pitch dictionaries have (#620) shows under All, as in Default.
+  const metadataOnly = { ...citadelResult, term: { ...citadelResult.term, expression: "東京タワー", reading: "とうきょうタワー", glossaries: [] } };
+  view.renderResults([metadataOnly, citadelSecond], { query: "東京タワー" }, citadelContext);
+  assert.deepEqual([...popup.querySelectorAll(".citadel-result")].map(result => result.hidden), [false, false]);
+  assert.equal(bound.current.miningActions.length, 2);
+  assert.deepEqual([...popup.querySelectorAll(".citadel-tab")].map(tab => tab.textContent), ["All", "Japanese"]);
+  popup.querySelectorAll(".citadel-tab")[1].click();
+  assert.deepEqual([...popup.querySelectorAll(".citadel-result")].map(result => result.hidden), [true, false]);
+});
