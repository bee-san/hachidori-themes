+test("Citadel opens Note beneath the header, keeps drafts and lists extra custom actions under More", t => {
+  const saves = [];
+  const { popup, view } = citadelFixture(t, { onAddCustomEntry(entry) { saves.push({ ...entry }); },
+    customButtons: ["one", "two", "three"].map(id => ({ id, type: "link", label: id, url: `https://example.test/${id}` })) });
+  view.renderResults([citadelResult, citadelSecond], { query: "食べた" }, citadelContext);
+  const actions = [...popup.querySelectorAll(".gsm-hoshidicts-entry-actions[aria-label='Entry actions']")];
+  assert.deepEqual(actions.map(group => [...group.querySelectorAll(":scope .citadel-custom-action-icon")].map(icon => icon.dataset.icon)),
+    [["open", "open", "open"], ["open", "open", "open"]]);
+  assert.equal(popup.querySelectorAll(".citadel-more-actions .citadel-action-menu [data-custom-button-id='three']").length, 2);
+  const [first, second] = [...popup.querySelectorAll(".gsm-hoshidicts-note-button")];
+  first.click();
+  const form = popup.querySelector("form");
+  assert.equal(popup.querySelector(".citadel-head").nextElementSibling, form, "the pencil opens Note just beneath its header");
+  form.elements.definition.value = "My meaning";
+  view.updateDictionaryPresentation({ ...citadelContext, dictionaryTabGroups: [] });
+  assert.equal(form.hidden, false);
+  assert.equal(form.elements.definition.value, "My meaning", "presentation updates keep a draft");
+  form.dispatchEvent(new popup.ownerDocument.defaultView.Event("submit", { cancelable: true }));
+  assert.deepEqual(saves, [{ term: "食べる", reading: "たべる", definition: "My meaning" }]);
+  second.click();
+  assert.equal(popup.querySelectorAll(".citadel-head")[1].nextElementSibling.matches("form"), true);
+  assert.equal(view.closeNoteForm(), true);
+  const more = popup.querySelector(".citadel-more-actions");
+  more.open = true;
+  assert.equal(view.closeActionMenu(), true);
+  assert.equal(more.open, false);
+  view.renderNotice("No results", { query: "ぬぺぽ", sentence: "ぬぺぽ。" });
+  popup.querySelector(".citadel-nav .gsm-hoshidicts-note-button").click();
+  assert.equal(popup.querySelector(".gsm-hoshidicts-lookup-notice").nextElementSibling, popup.querySelector("form"),
+    "a missing word's pencil opens Note beneath the notice");
+  assert.equal(popup.querySelector("form").elements.term.value, "ぬぺぽ");
+});
